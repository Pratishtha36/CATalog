# Comma-separated frontend origins. Set the deployed Vercel origin on Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Defaults to backend/cabwise.db. Use a persistent disk path on Render.
# DATABASE_URL=sqlite:////var/data/cabwise.db

# Optional persistent directory for the trained phone forest.
# MOTION_MODEL_DIR=/var/data/motion-models

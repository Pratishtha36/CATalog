# Copy to ignored backend/.env locally; set these in Render Environment when deployed.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Use the full Supabase transaction-pooler URI with a URL-encoded password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
